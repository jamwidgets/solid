{
  "name": "@jamwidgets/solid",
  "version": "0.7.0",
  "description": "SolidJS primitives for Jamwidgets (forms, comments, reactions, subscriptions)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamwidgets/solid.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://jamwidgets.com",
  "author": "Tim Marks <tim@imothee.xyz>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "keywords": [
    "solid",
    "solidjs",
    "jamwidgets",
    "forms",
    "comments",
    "reactions",
    "subscribe",
    "primitives"
  ],
  "license": "MIT",
  "dependencies": {
    "@jamwidgets/core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.14",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "2.11.13",
    "vitest": "^4.1.11"
  }
}
